# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# ── App ──────────────────────────────────────────────────────────────────────────────
# Base URL for canonical links, QR codes and emails.
APP_URL=http://localhost:5173
# STOEDIO showcase: one-tap logins, mock providers, ribbon, nightly reset.
DEMO_MODE=true
# Random string, at least 32 characters (signs session and device cookies). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
# Staff password session length in days (12–30).
SESSION_DAYS=14
# Vercel Cron sends this as a Bearer token.
CRON_SECRET=change-me
# Optional: a Vercel Deploy Hook the nightly job calls when menus or branch info changed,
# so prerendered pages and their JSON-LD are at most a day old.
VERCEL_DEPLOY_HOOK_URL=

# ── Firebase ─────────────────────────────────────────────────────────────────────────
# Local: talk to the emulators (npm run emulators). No cloud account needed.
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-bara
# Production: a service account from Firebase console → Project settings → Service accounts.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Browser SDK for the staff screens' realtime listeners (any value works with the emulators).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-bara
VITE_FIREBASE_AUTH_DOMAIN=demo-bara.firebaseapp.com
VITE_USE_FIREBASE_EMULATORS=true

# ── Seed ─────────────────────────────────────────────────────────────────────────────
# Password for every seeded account that has one (default: bara-demo-2026).
SEED_PASSWORD=

# ── Providers (later phases; mock is used until these are set, and always in DEMO_MODE) ──
# Email
RESEND_API_KEY=
EMAIL_FROM="Bara <hello@bara.stoedio.com>"
# Payments, per branch: Midtrans (JKT, DPS), Stripe (KUL, SIN), TapPay (TPE)
MIDTRANS_SERVER_KEY_JKT=
MIDTRANS_SERVER_KEY_DPS=
STRIPE_SECRET_KEY_KUL=
STRIPE_WEBHOOK_SECRET_KUL=
STRIPE_SECRET_KEY_SIN=
STRIPE_WEBHOOK_SECRET_SIN=
TAPPAY_PARTNER_KEY_TPE=
TAPPAY_MERCHANT_ID_TPE=
# Invoices: ECPay e-invoice (TPE), LHDN MyInvois (KUL)
ECPAY_EINVOICE_MERCHANT_ID_TPE=
ECPAY_EINVOICE_HASH_KEY_TPE=
ECPAY_EINVOICE_HASH_IV_TPE=
MYINVOIS_CLIENT_ID_KUL=
MYINVOIS_CLIENT_SECRET_KUL=
# Messaging: LINE (TPE), WhatsApp Business Cloud API (optional; click-to-chat links otherwise)
LINE_CHANNEL_ACCESS_TOKEN_TPE=
LINE_CHANNEL_SECRET_TPE=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
