{
  "name": "bara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "routes": "tsx scripts/gen-routes.ts",
    "dev": "npm run routes && vite",
    "build": "npm run routes && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rules": "node scripts/firebase.mjs emulators:exec --only firestore \"vitest run --project rules\"",
    "test:integration": "node scripts/firebase.mjs emulators:exec --only firestore,auth \"vitest run --project integration\"",
    "emulators": "node scripts/firebase.mjs emulators:start --import=.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/functions": "^3.10.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
